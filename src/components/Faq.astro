---
import MonoLabel from "./MonoLabel.astro";
import type { Faq } from "../data/products-content";
interface Props { items: Faq[]; }
const { items } = Astro.props;
---
<div class="divide-y divide-line border-y border-line">
  {items.map((f) => (
    <details class="group">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5">
        <span class="font-display text-lg font-bold">{f.q}</span>
        <span class="font-mono text-accent transition-transform group-open:rotate-45">+</span>
      </summary>
      <p class="pb-5 text-ink-soft">{f.a}</p>
    </details>
  ))}
</div>
