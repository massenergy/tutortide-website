---
import BaseLayout from "../layouts/BaseLayout.astro";
import MonoLabel from "../components/MonoLabel.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProductGrid from "../components/ProductGrid.astro";
import CTABand from "../components/CTABand.astro";
---
<BaseLayout
  title="Products"
  description="The Tutortide AI Student Companion is our live product for schools. Nyokavi, Waterpro and Tundamoto are in development."
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
      <MonoLabel class="mb-6 block">Our products</MonoLabel>
      <h1 class="max-w-4xl text-4xl font-bold leading-[1.05] md:text-6xl">
        One product in schools. Three in development.
      </h1>
      <p class="mt-8 max-w-2xl text-lg text-ink-soft">
        The Tutortide AI Student Companion is live in schools in Kenya. Nyokavi, Waterpro and
        Tundamoto are the tools we are working on next.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 md:px-8">
    <ProductGrid />
  </section>

  <CTABand title="Questions about a product? Talk to us." ctaLabel="Contact us" ctaHref="/contact" />
</BaseLayout>
