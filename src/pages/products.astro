---
import BaseLayout from "../layouts/BaseLayout.astro";
import MonoLabel from "../components/MonoLabel.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProductGrid from "../components/ProductGrid.astro";
import CTABand from "../components/CTABand.astro";
---
<BaseLayout
  title="Products"
  description="Explore Tutortide's products: Jinjing (AI student companion), Nyokavi (community platform), Waterpro (water operations), and Tundamoto (project & operations)."
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
      <MonoLabel class="mb-6 block">Our products</MonoLabel>
      <h1 class="max-w-4xl text-4xl font-bold leading-[1.05] md:text-6xl">
        Four products. One company website.
      </h1>
      <p class="mt-8 max-w-2xl text-lg text-ink-soft">
        Every product has its own landing page here and its own application on a dedicated
        subdomain. Explore the product, then launch the app.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 md:px-8">
    <ProductGrid />
  </section>

  <CTABand title="Not sure which fits? Talk to us." ctaLabel="Contact us" ctaHref="/contact" />
</BaseLayout>
