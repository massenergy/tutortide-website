---
import BaseLayout from "../layouts/BaseLayout.astro";
import MonoLabel from "../components/MonoLabel.astro";
import Button from "../components/Button.astro";
import GridCell from "../components/GridCell.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CTABand from "../components/CTABand.astro";
import { flagship } from "../data/site";

const demoUrl = "https://ai-student-companion-demo.web.app";
const csv = "/demo/grade7-pupils.csv";
const tryUrl = `${demoUrl}/try`;

const cards = [
  "Class teacher, 7A Maths", "Head teacher", "Pupil, 7A", "Second pupil, 7A", "Parent of a 7A pupil",
  "New teacher, Baraka Academy", "Parent teaching at home", "Adult learner", "Ministry of Education",
];

const walks = [
  {
    title: "A new school's first day",
    card: "New teacher, Baraka Academy",
    time: "2 minutes",
    steps: [
      "The app asks you to set a new password (at least 10 characters, including one of @$!%*?&).",
      "Read the terms and press Accept and Continue.",
      "You are now the school's admin. The home screen shows “Set up your school”: nine steps, from choosing the curriculum to giving out the first assignment. Later steps wait until the earlier ones are done.",
    ],
    note: "This works once in your copy: after you have set the password, Grace is no longer new. Use the password you chose to come back to her today.",
  },
  {
    title: "Add a class of pupils from one file",
    card: "Class teacher, 7A Maths",
    time: "3 minutes",
    steps: [
      "Download the sample file (the button is below this list).",
      "Open Students, then Classrooms Register, then 7A. It has 14 pupils.",
      "Open Students, then Add Many Students At Once. The page shows the columns the file needs.",
      "Drop the file into the box and press Upload CSV & Send Invites.",
      "Open Classrooms Register and 7A again. Five new pupils are there, so 7A has 19.",
    ],
    note: "The page shows no confirmation after the upload; the register is the proof. The file works once in your copy: a second upload says the pupils already exist. No email leaves the demo.",
    download: true,
  },
  {
    title: "The auto marker",
    card: "Class teacher, 7A Maths",
    time: "5 minutes",
    soon: "Coming soon in your own copy: two handwritten scripts already marked, waiting for the teacher to check. Until then, this walk has nothing to review.",
    steps: [
      "Open Auto marker. Under “Waiting to be checked”, open the marked scripts.",
      "Every question shows the question from the paper, the marking scheme's answer, the pupil's answer as the marker read it, and the mark.",
      "Change any mark you disagree with. Anything the marker was unsure of is yours to decide: the teacher has the last word.",
      "Press Return. Nothing reaches a pupil before this. Then switch role to the pupil to see what they see.",
    ],
  },
  {
    title: "End-of-term report forms",
    card: "Class teacher, 7A Maths",
    time: "4 minutes",
    steps: [
      "Open Report forms and choose Grade 7 7A, Term 1 2026, End of term.",
      "The board lists nine subjects with the teacher for each, and whether their marks and remarks are in. Eight are complete; Mathematics is waiting for Faith.",
      "Open Generate reports for the same class: one row per pupil, built from the term's homework, quizzes and exams. Nobody types a mark into a form.",
      "Open one pupil's form to see each subject's mark, the teacher who taught it and that teacher's comment.",
      "Open Remarks to see where Faith writes her Mathematics comment.",
    ],
  },
  {
    title: "A parent teaching at home",
    card: "Parent teaching at home",
    time: "2 minutes",
    steps: [
      "The home screen shows Emma's two children, Liam (Grade 4) and Ava (Grade 6), and her first steps.",
      "Each child shows “needs your consent”. A child cannot use the AI tutor until a parent has agreed. Open the consent form to read what is asked.",
      "Open Progress and pick a child: certificates, marked papers and report forms appear here.",
    ],
  },
  {
    title: "An adult learner",
    card: "Adult learner",
    time: "2 minutes",
    steps: [
      "Daniel learns for himself, so nobody else gives consent for him.",
      "Open Jinjing AI tutor and ask a question.",
      "Find the subscription card: the free trial, the days left and the price.",
    ],
  },
];
---
<BaseLayout
  title="Try the demo"
  description="Try the Tutortide AI Student Companion in your own private copy of a school: one click signs you in as a teacher, a pupil, a parent or an adult learner. Step-by-step walks."
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
      <MonoLabel class="mb-6 block">{flagship.name}</MonoLabel>
      <h1 class="max-w-4xl text-4xl font-bold leading-[1.05] md:text-6xl">Try it yourself.</h1>
      <p class="mt-8 max-w-2xl text-lg text-ink-soft">
        Press Try it now and you get your own private copy of a school, with invented teachers,
        pupils and parents. One click signs you in as any of them. Nobody else sees what you do.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <Button href={tryUrl} variant="solid" target="_blank" rel="noopener">Try it now ↗</Button>
        <Button href="#walks" variant="outline">What to try</Button>
      </div>
    </div>
  </section>

  <!-- Know before you start -->
  <section class="mx-auto max-w-7xl px-5 py-20 md:px-8">
    <SectionHeader eyebrow="Before you start" title="Three things to know." />
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      <GridCell class="p-8">
        <MonoLabel>Your own copy</MonoLabel>
        <p class="mt-4 font-display text-2xl font-bold">Nobody else is in it</p>
        <p class="mt-3 text-ink-soft">
          Each visitor gets a private copy of the school. Add pupils, change marks, send report
          forms: it touches no one else's copy. Everyone in it is invented.
        </p>
      </GridCell>
      <GridCell class="p-8">
        <MonoLabel>Cleared each night</MonoLabel>
        <p class="mt-4 font-display text-2xl font-bold">05:00 Nairobi time</p>
        <p class="mt-3 text-ink-soft">
          02:00 UTC. Your copy lasts the day. The email we send you brings you back to it until
          then; after that, press Try it now again for a fresh one.
        </p>
      </GridCell>
      <GridCell class="p-8">
        <MonoLabel>Your email</MonoLabel>
        <p class="mt-4 font-display text-2xl font-bold">Two emails at most</p>
        <p class="mt-3 text-ink-soft">
          Your demo link, and one more the next day asking how it went. Nothing else.
        </p>
      </GridCell>
    </div>
  </section>

  <!-- How it works (id kept: older links point to #accounts) -->
  <section id="accounts" class="scroll-mt-24 border-y border-line bg-surface">
    <div class="mx-auto max-w-7xl px-5 py-20 md:px-8">
      <SectionHeader eyebrow="How it works" title="Who you can be." support="Type your name and email, pass a quick check, then pick a card. A Switch role button brings you back to the cards at any time." />
      <ul class="mt-12 grid gap-3 md:grid-cols-3">
        {cards.map((c) => (
          <li class="border border-line px-5 py-4 font-display font-bold">{c}</li>
        ))}
      </ul>
      <div class="mt-10">
        <Button href={tryUrl} variant="solid" target="_blank" rel="noopener">Try it now ↗</Button>
      </div>
    </div>
  </section>

  <!-- Walks -->
  <section id="walks" class="scroll-mt-24 mx-auto max-w-7xl px-5 py-20 md:px-8">
    <SectionHeader eyebrow="Walks" title="What to try, step by step." support="Each walk takes a few minutes. Do them in any order." />
    <div class="mt-12 grid gap-4">
      {walks.map((w, i) => (
        <GridCell class="p-8">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-2xl font-bold">
              <span class="mr-3 font-mono text-xs text-ink-soft">{String(i + 1).padStart(2, "0")}</span>{w.title}
            </h3>
            <MonoLabel>{w.time}</MonoLabel>
          </div>
          <p class="mt-3 font-mono text-sm text-ink-soft">Card: {w.card}</p>
          {w.soon && <p class="mt-4 max-w-3xl border-l border-accent pl-4 font-medium">{w.soon}</p>}
          <ol class="mt-6 max-w-3xl list-decimal space-y-3 pl-5 text-ink-soft marker:font-mono marker:text-xs">
            {w.steps.map((s) => <li class="pl-2">{s}</li>)}
          </ol>
          {w.download && (
            <div class="mt-6">
              <Button href={csv} variant="outline">Download the sample file (CSV)</Button>
            </div>
          )}
          {w.note && <p class="mt-6 max-w-3xl border-l border-accent pl-4 text-sm text-ink-soft">{w.note}</p>}
        </GridCell>
      ))}
    </div>
  </section>

  <CTABand
    eyebrow="Ready to use it for real?"
    title="Teachers, parents and adult learners can join today."
    ctaLabel="Create your account"
    ctaHref={flagship.app}
  />
</BaseLayout>
