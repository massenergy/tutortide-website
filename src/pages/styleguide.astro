---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import MonoLabel from "../components/MonoLabel.astro";
import Button from "../components/Button.astro";
import GridCell from "../components/GridCell.astro";
import StatNumber from "../components/StatNumber.astro";
import DottedGrid from "../components/DottedGrid.astro";
import { products } from "../data/site";

const swatches = [
  ["canvas", "#f6f6f4"],
  ["surface", "#ffffff"],
  ["ink", "#111111"],
  ["ink-soft", "#5b5b55"],
  ["line", "#e3e3dd"],
  ["accent", "#1a44ff"],
];
---
<BaseLayout title="Styleguide" description="Design system reference — internal">
  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8">
    <MonoLabel>Internal / design system</MonoLabel>
    <h1 class="mt-4 text-4xl font-bold md:text-6xl">Styleguide</h1>
  </section>

  <!-- Color -->
  <section class="mx-auto max-w-7xl px-5 py-10 md:px-8">
    <SectionHeader eyebrow="01 — Color" title="Palette" support="Near-white canvas, near-black ink, one royal-blue accent used sparingly." />
    <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-6">
      {swatches.map(([name, hex]) => (
        <div class="border border-line">
          <div class="h-20" style={`background:${hex}`}></div>
          <div class="p-3">
            <p class="font-mono text-xs">{name}</p>
            <p class="font-mono text-xs text-ink-soft">{hex}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Type -->
  <section class="mx-auto max-w-7xl px-5 py-10 md:px-8">
    <SectionHeader eyebrow="02 — Type" title="Typography" support="Space Grotesk display, JetBrains Mono labels, Inter body." />
    <div class="mt-8 space-y-4">
      <p class="font-display text-6xl font-bold tracking-tight">Display / Space Grotesk</p>
      <p class="mono-label">Mono label / JetBrains Mono — PROCESSING //</p>
      <p class="max-w-2xl text-ink-soft">Body / Inter — Delivering innovative software with a core focus on positive societal change, accessible and impactful technology for underserved communities.</p>
    </div>
  </section>

  <!-- Buttons -->
  <section class="mx-auto max-w-7xl px-5 py-10 md:px-8">
    <SectionHeader eyebrow="03 — Actions" title="Buttons" />
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button href="#" variant="solid">Request demo</Button>
      <Button href="#" variant="outline">Learn more</Button>
      <Button href="#" variant="solid" mono={false}>Non-mono</Button>
    </div>
    <div class="mt-6">
      <Button href="#" variant="solid" full>Full-width CTA bar</Button>
    </div>
  </section>

  <!-- Grid cells + ticks -->
  <section class="mx-auto max-w-7xl px-5 py-10 md:px-8">
    <SectionHeader eyebrow="04 — Grid" title="Cells & corner ticks" />
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {["Agentic Search", "Workflow Orchestration", "Review & Collaboration"].map((t) => (
        <GridCell class="p-6">
          <MonoLabel>Capability</MonoLabel>
          <h3 class="mt-3 text-xl font-bold">{t}</h3>
          <p class="mt-2 text-sm text-ink-soft">Integrate with existing systems to incorporate accepted information into decisions and minimize the approval surface.</p>
        </GridCell>
      ))}
    </div>
  </section>

  <!-- Stats -->
  <DottedGrid class="border-y border-line">
    <section class="mx-auto max-w-7xl px-5 py-14 md:px-8">
      <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
        <StatNumber value="10x" caption="Faster sharing" />
        <StatNumber value="932" caption="Documents processed" />
        <StatNumber value="318" caption="Reviews" />
        <StatNumber value="98%" caption="Match identified" />
      </div>
    </section>
  </DottedGrid>

  <!-- Product cards -->
  <section class="mx-auto max-w-7xl px-5 py-14 md:px-8">
    <SectionHeader eyebrow="05 — Products" title="Product cards" />
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {products.map((p) => (
        <GridCell href={p.slug} class="p-6 transition-colors hover:border-accent">
          <MonoLabel>Product</MonoLabel>
          <h3 class="mt-3 text-2xl font-bold">{p.name}</h3>
          <p class="mt-2 text-sm text-ink-soft">{p.blurb}</p>
          <span class="mono-label mt-6 inline-block text-accent">Explore →</span>
        </GridCell>
      ))}
    </div>
  </section>
</BaseLayout>
