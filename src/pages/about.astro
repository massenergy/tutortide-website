---
import BaseLayout from "../layouts/BaseLayout.astro";
import MonoLabel from "../components/MonoLabel.astro";
import GridCell from "../components/GridCell.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CTABand from "../components/CTABand.astro";
import { site, team, flagship, traction } from "../data/site";

const initials = (name: string) => name.split(" ").map((w) => w[0]).join("");

const company = [
  { label: "Registered name", value: site.legalName },
  { label: "Company number", value: site.registration },
  { label: "Incorporated", value: `${site.incorporated}, Kenya` },
  { label: "Based in", value: site.location },
  { label: "Postal address", value: site.postal },
  { label: "Email", value: site.email, href: `mailto:${site.email}` },
  { label: "Phone", value: site.phone, href: `tel:${site.phone.replaceAll(" ", "")}` },
  { label: "LinkedIn", value: "linkedin.com/company/tutortide-limited", href: site.linkedin },
];

const principles = [
  { title: "Children's safety first", body: "Parental consent and safeguarding review are built into the product, not added on." },
  { title: "Aligned to the curriculum", body: "Tutoring and marking follow the syllabus pupils are examined on." },
  { title: "Teachers stay in charge", body: "A teacher checks the AI's marking against the pupil's own script before results are published." },
  { title: "Built where it is used", body: "Built in Kenya, for the classrooms we know." },
];
---
<BaseLayout
  title="About"
  description="Tutortide Limited is a Kenyan education technology company founded in 2024. Meet the team behind the Tutortide AI Student Companion."
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
      <MonoLabel class="mb-6 block">About Tutortide</MonoLabel>
      <h1 class="max-w-4xl text-4xl font-bold leading-[1.05] md:text-6xl">
        A Kenyan education technology company.
      </h1>
      <p class="mt-8 max-w-2xl text-lg text-ink-soft">
        Founded in 2024 and based in {site.location}, {site.legalName} builds the{" "}
        <a href={flagship.slug} class="underline hover:text-accent">{flagship.name}</a>:
        AI tutoring for pupils and marking for teachers. It is in use at {traction.schools} schools
        with {traction.pupils} pupils in {traction.country}.
      </p>
    </div>
  </section>

  <section id="team" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-20 md:px-8">
    <SectionHeader eyebrow="Team" title="Who we are." />
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {team.map((m) => (
        <GridCell class="flex gap-6 p-8">
          <span class="flex h-16 w-16 shrink-0 items-center justify-center border border-line font-display text-xl font-bold text-accent" aria-hidden="true">
            {initials(m.name)}
          </span>
          <div>
            <h3 class="text-xl font-bold">{m.name}</h3>
            <p class="mono-label mt-1">{m.role}</p>
            <p class="mt-3 text-ink-soft">{m.bio}</p>
            <a href={m.linkedin} target="_blank" rel="noopener" class="mono-label mt-4 inline-block text-accent hover:underline">
              LinkedIn ↗
            </a>
          </div>
        </GridCell>
      ))}
    </div>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-7xl px-5 py-20 md:px-8">
      <SectionHeader eyebrow="Company" title="Company details." />
      <dl class="mt-12 grid gap-x-10 border-t border-line md:grid-cols-2">
        {company.map((c) => (
          <div class="flex items-baseline justify-between gap-6 border-b border-line py-4">
            <dt class="font-mono text-xs uppercase tracking-widest text-ink-soft">{c.label}</dt>
            <dd class="text-right font-medium">
              {c.href ? <a href={c.href} class="transition-colors hover:text-accent">{c.value}</a> : c.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 md:px-8">
    <SectionHeader eyebrow="How we work" title="What we hold to." />
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {principles.map((v, i) => (
        <div class="border-l border-line pl-5">
          <span class="font-mono text-xs text-ink-soft">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="mt-2 font-display text-lg font-bold">{v.title}</h3>
          <p class="mt-2 text-sm text-ink-soft">{v.body}</p>
        </div>
      ))}
    </div>
  </section>

  <CTABand title="Questions about Tutortide? Talk to us." ctaLabel="Get in touch" ctaHref="/contact" />
</BaseLayout>
