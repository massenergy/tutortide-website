---
import BaseLayout from "../layouts/BaseLayout.astro";
import MonoLabel from "../components/MonoLabel.astro";
import Button from "../components/Button.astro";
import GridCell from "../components/GridCell.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProductGrid from "../components/ProductGrid.astro";
import CTABand from "../components/CTABand.astro";
import { site, flagship, traction, products } from "../data/site";

const glance = [
  { label: "Schools", value: traction.schools },
  { label: "Pupils", value: traction.pupils },
  { label: "Country", value: traction.country },
  { label: "Founded", value: "2024" },
  { label: "Pupil data", value: "Google Cloud" },
];

const audiences = [
  {
    who: "For pupils",
    title: "Jinjing, an AI tutor",
    body: "Explains concepts, sets practice and gives instant feedback, aligned to the curriculum pupils are examined on.",
  },
  {
    who: "For teachers",
    title: "Marking and planning done",
    body: "Automatic marking of handwritten exam scripts, lesson planning, class analysis and report forms.",
  },
  {
    who: "For parents and schools",
    title: "Progress and safety",
    body: "Clear progress reports, verifiable certificates, parental consent and safeguarding review.",
  },
];

const others = products.filter((p) => p.slug !== flagship.slug);
---
<BaseLayout
  title="Tutortide"
  description={`Tutortide Limited is a Kenyan education technology company. Our AI Student Companion tutors pupils and marks exam scripts for teachers, in use at ${traction.schools} schools with ${traction.pupils} pupils.`}
>
  <!-- Hero -->
  <section class="border-b border-line">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 md:grid-cols-12 md:px-8 md:py-28">
      <div class="md:col-span-7">
        <MonoLabel class="mb-6 block">{flagship.name}</MonoLabel>
        <h1 class="text-4xl font-bold leading-[1.03] md:text-6xl">
          A tutor for every pupil.<br />Hours back for every teacher.
        </h1>
        <p class="mt-8 max-w-xl text-lg text-ink-soft">
          {site.legalName} is a Kenyan education technology company. Our AI Student Companion
          tutors pupils, marks handwritten exam scripts and keeps parents informed. It is in use
          at {traction.schools} schools with {traction.pupils} pupils in {traction.country}.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <Button href={flagship.slug} variant="solid">See the product</Button>
          <Button href="/about#team" variant="outline">Meet the team</Button>
        </div>
      </div>
      <div class="md:col-span-5">
        <GridCell class="h-full p-6">
          <MonoLabel>At a glance</MonoLabel>
          <dl class="mt-6 divide-y divide-line">
            {glance.map((g) => (
              <div class="flex items-baseline justify-between py-3">
                <dt class="font-mono text-xs uppercase tracking-widest text-ink-soft">{g.label}</dt>
                <dd class="font-display text-xl font-bold">{g.value}</dd>
              </div>
            ))}
          </dl>
        </GridCell>
      </div>
    </div>
  </section>

  <!-- What it does -->
  <section class="mx-auto max-w-7xl px-5 py-20 md:px-8">
    <SectionHeader
      eyebrow="What it does"
      title="One platform for the whole school."
      support="Pupils learn with a tutor, teachers get their time back, and parents can see how their child is doing."
    />
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {audiences.map((a, i) => (
        <GridCell travel index={i} class="p-8">
          <MonoLabel>{a.who}</MonoLabel>
          <h3 class="mt-4 text-2xl font-bold">{a.title}</h3>
          <p class="mt-3 text-ink-soft">{a.body}</p>
        </GridCell>
      ))}
    </div>
    <div class="mt-10 flex flex-wrap gap-4">
      <Button href={flagship.slug} variant="solid">How it works</Button>
      <Button href="/demo" variant="outline">Try the demo</Button>
    </div>
  </section>

  <!-- Other products -->
  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-7xl px-5 py-20 md:px-8">
      <SectionHeader
        eyebrow="Also from Tutortide"
        title="In development."
        support="Other tools we are working on for communities and small businesses."
      />
      <ProductGrid class="mt-12" items={others} />
    </div>
  </section>

  <CTABand
    eyebrow="Schools, partners and funders"
    title="Want to see it in a classroom? Talk to us."
    ctaLabel="Get in touch"
    ctaHref="/contact"
  />
</BaseLayout>
